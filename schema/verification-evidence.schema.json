{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mumei-lang.org/schema/verification-evidence.schema.json",
  "title": "Mumei Verification Evidence v1",
  "description": "Standalone representation contract. Validation does not establish proof truth, hash/file correspondence, freshness, producer trust, source fidelity or any Seal Grade. Existing proof certificates are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "specification",
    "obligation_id",
    "semantics",
    "method",
    "execution",
    "result",
    "scope",
    "correspondence",
    "assumptions",
    "exclusions",
    "provenance",
    "artifact_paths"
  ],
  "properties": {
    "schema_version": {"const":"mumei.verification-evidence/v1"},
    "subject": {"$ref":"#/$defs/subject"},
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","sha256"],
      "properties": {"id":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha256"}}
    },
    "obligation_id": {"type":"string","minLength":1},
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile","integer_model","target_triple"],
      "properties": {
        "profile": {"type":"string","minLength":1},
        "integer_model": {"enum":["mathematical_integer","checked_i64","wrapping_i64","not_applicable"]},
        "target_triple": {"type":["string","null"],"minLength":1}
      }
    },
    "method": {
      "enum": [
        "deductive_proof",
        "abstract_interpretation",
        "bounded_model_checking",
        "finite_execution",
        "static_heuristic",
        "identity_check"
      ]
    },
    "execution": {"enum":["completed","timeout","resource_limit","tool_error","not_run"]},
    "result": {
      "enum": [
        "established",
        "counterexample",
        "observed_no_failure",
        "finding",
        "unknown",
        "unsupported",
        "not_checked",
        "inconsistent"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind","bounds"],
      "properties": {
        "kind": {"enum":["unbounded","bounded","finite","identity"]},
        "bounds": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
      }
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation","status","notes"],
      "properties": {
        "relation": {
          "enum": [
            "exact_model",
            "property_preserving",
            "over_approximation",
            "under_approximation",
            "unchecked",
            "unsupported"
          ]
        },
        "status": {"enum":["validated","assumed","unverified","unsupported"]},
        "notes": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
      }
    },
    "assumptions": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "exclusions": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter","tool","configuration_fingerprint"],
      "properties": {
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id","version","protocol_version"],
          "properties": {
            "id": {"type":"string","minLength":1},
            "version": {"type":"string","minLength":1},
            "protocol_version": {"type":"string","minLength":1}
          }
        },
        "tool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name","version"],
          "properties": {"name":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/sha256",
          "description": "Hash of approved non-secret configuration only; never hash credentials or a secret-derived projection."
        },
        "translator_version": {"type":["string","null"],"minLength":1},
        "bridge_lemma_hash": {"anyOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]}
      }
    },
    "artifact_paths": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
  },
  "$defs": {
    "sha256": {"type":"string","minLength":64,"maxLength":64,"pattern":"^[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","kind","sha256"],
      "properties": {
        "id": {"type":"string","minLength":1},
        "kind": {"enum":["mumei_source","foreign_source","model","lowered_ir","native_artifact","wasm_artifact"]},
        "sha256": {"$ref":"#/$defs/sha256"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"execution":{"enum":["timeout","resource_limit","tool_error","not_run"]}},
        "required": ["execution"]
      },
      "then": {"properties":{"result":{"enum":["unknown","unsupported","not_checked"]}}}
    },
    {
      "if": {"properties":{"result":{"enum":["established"]}},"required":["result"]},
      "then": {
        "properties": {
          "execution": {"const":"completed"},
          "method": {"enum":["deductive_proof","abstract_interpretation","bounded_model_checking","identity_check"]}
        }
      }
    },
    {
      "if": {"properties":{"result":{"enum":["counterexample"]}},"required":["result"]},
      "then": {
        "properties": {
          "execution": {"const":"completed"},
          "method": {"enum":["deductive_proof","bounded_model_checking","finite_execution"]}
        }
      }
    },
    {
      "if": {"properties":{"result":{"enum":["observed_no_failure"]}},"required":["result"]},
      "then": {"properties":{"execution":{"const":"completed"},"method":{"const":"finite_execution"}}}
    },
    {
      "if": {"properties":{"result":{"enum":["finding"]}},"required":["result"]},
      "then": {"properties":{"execution":{"const":"completed"},"method":{"const":"static_heuristic"}}}
    },
    {
      "if": {"properties":{"method":{"enum":["finite_execution"]}},"required":["method"]},
      "then": {
        "properties": {
          "scope": {"properties":{"kind":{"const":"finite"}}},
          "result": {
            "enum": ["observed_no_failure","counterexample","unknown","unsupported","not_checked","inconsistent"]
          }
        }
      }
    },
    {
      "if": {"properties":{"method":{"enum":["bounded_model_checking"]}},"required":["method"]},
      "then": {
        "properties": {
          "scope": {"properties":{"kind":{"const":"bounded"}}},
          "result": {"enum":["established","counterexample","unknown","unsupported","not_checked","inconsistent"]}
        }
      }
    },
    {
      "if": {"properties":{"method":{"enum":["identity_check"]}},"required":["method"]},
      "then": {
        "properties": {
          "scope": {"properties":{"kind":{"const":"identity"}}},
          "result": {"enum":["established","unknown","unsupported","not_checked","inconsistent"]}
        }
      }
    },
    {
      "if": {"properties":{"method":{"enum":["static_heuristic"]}},"required":["method"]},
      "then": {
        "properties": {
          "scope": {"properties":{"kind":{"enum":["unbounded","bounded"]}}},
          "result": {"enum":["finding","unknown","unsupported","not_checked","inconsistent"]}
        }
      }
    },
    {
      "if": {"properties":{"method":{"enum":["deductive_proof","abstract_interpretation"]}},"required":["method"]},
      "then": {"properties":{"scope":{"properties":{"kind":{"enum":["unbounded","bounded"]}}}}}
    },
    {
      "if": {"properties":{"scope":{"properties":{"kind":{"enum":["bounded","finite"]}}}}},
      "then": {"properties":{"scope":{"properties":{"bounds":{"minItems":1}}}}},
      "else": {"properties":{"scope":{"properties":{"bounds":{"maxItems":0}}}}}
    },
    {
      "if": {"properties":{"correspondence":{"properties":{"relation":{"const":"unchecked"}}}}},
      "then": {"properties":{"correspondence":{"properties":{"status":{"const":"unverified"}}}}}
    },
    {
      "if": {"properties":{"correspondence":{"properties":{"relation":{"const":"unsupported"}}}}},
      "then": {
        "properties": {
          "correspondence": {"properties":{"status":{"const":"unsupported"}}},
          "result": {"enum":["unknown","unsupported","not_checked"]}
        }
      }
    },
    {
      "if": {"properties":{"correspondence":{"properties":{"status":{"const":"unsupported"}}}}},
      "then": {
        "properties": {
          "correspondence": {"properties":{"relation":{"const":"unsupported"}}},
          "result": {"enum":["unknown","unsupported","not_checked"]}
        }
      }
    }
  ]
}
