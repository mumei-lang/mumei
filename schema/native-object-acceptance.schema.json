{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mumei-lang.org/schema/native-object-acceptance.schema.json",
  "title": "Mumei Native Object Route Acceptance Descriptor v1",
  "description": "Closed representation contract for the object-route mumei.native-evidence-acceptance/v1 descriptor emitted by `mumei native-bundle accept-object --json`. Validation establishes representation and internal consistency only; it does not rerun Core rechecks, authenticate the producer or descriptor, validate ABI/runtime/OS semantics, or promote a Seal Grade.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "acceptance",
    "accepted",
    "scope",
    "checks_performed",
    "checks_not_performed",
    "build_id",
    "llvm_sha256",
    "object_sha256",
    "evidence_fingerprint",
    "register_convention_assumed",
    "input_domain",
    "functions",
    "object_translation",
    "source_machine_tv"
  ],
  "properties": {
    "schema_version": { "const": "mumei.native-evidence-acceptance/v1" },
    "acceptance": { "const": "evaluated" },
    "accepted": { "const": true },
    "scope": {
      "enum": [
        "native_bundle_object_translation_correspondence",
        "native_bundle_object_translation_correspondence_without_object_link"
      ]
    },
    "checks_performed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks_not_performed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "build_id": { "$ref": "#/$defs/sha256" },
    "llvm_sha256": { "$ref": "#/$defs/sha256" },
    "object_sha256": { "$ref": "#/$defs/sha256" },
    "evidence_fingerprint": { "$ref": "#/$defs/sha256" },
    "register_convention_assumed": { "type": "string", "minLength": 1 },
    "input_domain": { "type": "string", "minLength": 1 },
    "functions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/function_entry" }
    },
    "object_translation": { "$ref": "#/$defs/object_translation" },
    "source_machine_tv": { "$ref": "#/$defs/source_machine_tv" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": { "const": "native_bundle_object_translation_correspondence" }
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "source_machine_tv": {
            "properties": {
              "object_link_correspondence": {
                "const": "checked_object_link_correspondence"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "native_bundle_object_translation_correspondence_without_object_link"
          }
        },
        "required": ["scope"]
      },
      "then": {
        "properties": {
          "source_machine_tv": {
            "properties": {
              "object_link_correspondence": {
                "const": "unchecked_not_translation_validated"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "function_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": {
          "enum": ["equivalent_within_profile", "outside_profile"]
        },
        "callee_saved_preservation": {
          "enum": ["preserved", "violated", "unknown"]
        },
        "reason": { "const": "not_a_source_atom" },
        "role": { "const": "entry_wrapper" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "outside_profile" } },
            "required": ["outcome"]
          },
          "then": { "required": ["reason"] }
        },
        {
          "if": {
            "properties": {
              "outcome": { "const": "equivalent_within_profile" }
            },
            "required": ["outcome"]
          },
          "then": { "not": { "required": ["reason"] } }
        }
      ]
    },
    "transformation_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation", "output_identity", "validation"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "output_identity": {
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "validation": { "type": "string", "minLength": 1 },
        "result": {
          "enum": [
            "checked_correspondence",
            "unchecked_not_translation_validated"
          ]
        }
      }
    },
    "object_function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ir_function",
        "object_symbol",
        "object_section",
        "object_offset",
        "object_size",
        "executable_address"
      ],
      "properties": {
        "ir_function": { "type": "string", "minLength": 1 },
        "object_symbol": { "type": "string", "minLength": 1 },
        "object_section": { "type": "string", "minLength": 1 },
        "object_offset": { "type": "integer", "minimum": 0 },
        "object_size": { "type": "integer", "minimum": 0 },
        "executable_address": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "object_relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_section",
        "object_offset",
        "kind",
        "target_symbol",
        "addend",
        "resolved_value",
        "applied_offset",
        "assumption"
      ],
      "properties": {
        "object_section": { "type": "string", "minLength": 1 },
        "object_offset": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "minLength": 1 },
        "target_symbol": { "type": "string", "minLength": 1 },
        "addend": { "type": "integer" },
        "resolved_value": {
          "anyOf": [{ "type": "integer" }, { "type": "null" }]
        },
        "applied_offset": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "assumption": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "correspondence_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "result", "detail"],
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "result": { "const": "checked" },
        "detail": { "type": "string" }
      }
    },
    "object_translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "transformations",
        "functions",
        "relocations",
        "correspondence"
      ],
      "properties": {
        "status": { "const": "checked_correspondence" },
        "transformations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/transformation_edge" }
        },
        "functions": {
          "type": "array",
          "items": { "$ref": "#/$defs/object_function" }
        },
        "relocations": {
          "type": "array",
          "items": { "$ref": "#/$defs/object_relocation" }
        },
        "correspondence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "checks"],
          "properties": {
            "status": { "const": "checked_correspondence" },
            "checks": {
              "type": "array",
              "minItems": 10,
              "items": { "$ref": "#/$defs/correspondence_check" },
              "allOf": [
                { "contains": { "properties": { "item": { "const": "function_coverage" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "function_count" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "llvm_ir_object_equivalence" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "relocation_targets" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "relocation_bounds" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "relocation_resolved_values" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "relocation_applied_values" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "hir_llvm_model_correspondence" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "object_data_correspondence" } }, "required": ["item"] } },
                { "contains": { "properties": { "item": { "const": "object_symbol_attribute_correspondence" } }, "required": ["item"] } }
              ]
            }
          }
        }
      }
    },
    "non_equivalent_function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome", "reason"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "outcome": { "const": "outside_profile" },
        "reason": { "const": "not_a_source_atom" }
      }
    },
    "source_machine_tv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "non_equivalent_functions",
        "unchecked_domains",
        "object_link_correspondence"
      ],
      "properties": {
        "status": { "const": "checked_source_machine_tv_within_profile" },
        "non_equivalent_functions": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_equivalent_function" }
        },
        "unchecked_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "object_link_correspondence": {
          "enum": [
            "checked_object_link_correspondence",
            "unchecked_not_translation_validated"
          ]
        }
      }
    }
  }
}
