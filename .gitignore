# 環境変数ファイル
.env
.env.*
!.env.example
.cargo/

# Python テスト実行生成物
__pycache__/
*.pyc
.pytest_cache/

# Rust ビルド成果物
/target
Cargo.lock

# Mumei 生成物
visualizer/report.json
*.ll
/*.rs
error.log
dist/

# Mumei 検証キャッシュ
.mumei_cache
.mumei/
std/**/.mumei/
/report.json

# SI-5 Phase 3-C: per-module proof certificates (intermediate artefacts).
# Generated by generate-std-certs.yml and release.yml; the aggregated
# std-proof-bundle.json is the only distributable — raw certs should not
# be committed to the repo.
std/certs/

# VS Code extension build artefacts
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/package-lock.json
editors/vscode/*.vsix

# テスト用一時ファイル
sword_test.mm
cross_spec.json
# `mumei verify --proof-cert` / benchmarks/run_benchmarks.py write
# `<source stem>.proof.json` into the working directory.
/*.proof.json
mumei-core/report.json
